# =========================
# BIDS-like dataset: keep metadata, ignore subject data + derivatives outputs
# =========================

# Ignore all subject raw data (privacy + size)
dataset/sub-*/

# Ignore all derivatives outputs by default...
dataset/derivatives/*

# ...but keep derivative "identity" and structure for reproducibility
!dataset/derivatives/preproc/
!dataset/derivatives/preproc/dataset_description.json

# Ignore actual subject-level derivative outputs
dataset/derivatives/preproc/sub-*/

# Optional: if you add sourcedata with videos etc, ignore it
dataset/sourcedata/


